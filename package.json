{
  "name": "agent-testbench",
  "version": "0.5.0",
  "private": false,
  "description": "Agent-native test environment for API workflows, auditable evidence, and quality gates.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:frontend": "node desktop/build.mjs",
    "demo:api-case": "node tools/examples/api-case-demo.mjs",
    "demo:one": "./bin/agent-testbench.sh demo",
    "demo:services": "node tools/examples/demo-service-server.mjs",
    "docs:cli-reference": "node tools/docs/generate-cli-reference.mjs",
    "docs:cli-reference:check": "node tools/docs/generate-cli-reference.mjs --check",
    "guard:dependencies": "bash tools/guardrails/check_dependency_baseline.sh",
    "guard:duplicates": "bash tools/guardrails/check_duplicate_code.sh",
    "guard:secrets": "bash tools/guardrails/check_secrets.sh",
    "lint:go": "bash tools/go-lint.sh",
    "lint:go:full": "bash tools/go-lint.sh --full",
    "quality": "bash scripts/quality-gate.sh",
    "quality:report": "QUALITY_GATE_STRICT=false bash scripts/quality-gate.sh",
    "quality:strict": "QUALITY_GATE_STRICT=true bash scripts/quality-gate.sh",
    "release-check": "bash tools/release-check.sh",
    "release:build": "bash scripts/build-release.sh",
    "release-check:mysql-real": "bash tools/smoke/mysql-real-store-release-check.sh",
    "release-check:mysql-real:preflight": "AGENT_TESTBENCH_REAL_MYSQL_RELEASE_DRY_RUN=1 bash tools/smoke/mysql-real-store-release-check.sh",
    "store:preflight:mysql": "bash tools/smoke/mysql-store-preflight.sh",
    "store:audit:mysql-goal": "bash tools/smoke/mysql-store-goal-audit.sh",
    "store:publish:mysql": "bash tools/smoke/mysql-store-publish-verified-env.sh",
    "store:restore:mysql": "bash tools/smoke/mysql-store-colleague-restore.sh",
    "smoke:api:mysql-store": "AGENT_TESTBENCH_DISABLE_SQLITE_STORE=1 node tools/smoke/mysql-store-api-smoke.mjs",
    "smoke:cli:sql-active": "AGENT_TESTBENCH_DISABLE_SQLITE_STORE=1 node tools/smoke/cli-active-store-smoke.mjs",
    "smoke:frontend": "npm run smoke:desktop",
    "smoke:frontend:sql-active": "npm run smoke:frontend",
    "smoke:release-archive-serve": "node --test tools/smoke/release-archive-serve.test.mjs",
    "test:frontend": "node --test desktop/renderer/*.test.mjs desktop/*.test.cjs desktop/*.test.mjs desktop/assistant/*.test.mjs control-plane/frontend/src/workflowStudioModel.test.mjs",
    "test": "go test ./...",
    "desktop:build": "node desktop/build.mjs --engine",
    "desktop:start": "node desktop/open.mjs",
    "desktop:dev": "npm run desktop:build && AGENT_TESTBENCH_DESKTOP_DEV=1 electron desktop/main.cjs",
    "desktop:install": "node desktop/build.mjs --engine --package --install",
    "desktop:package": "node desktop/build.mjs --engine --package",
    "smoke:desktop": "node desktop/smoke.mjs",
    "smoke:assistant": "node desktop/assistant-smoke.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@electron/packager": "20.3.0",
    "@xyflow/react": "^12.10.2",
    "electron": "44.4.5",
    "esbuild": "^0.28.0",
    "lucide-react": "^1.14.0",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "main": "desktop/main.cjs",
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@langchain/openai": "1.6.2",
    "langchain": "1.5.16",
    "undici": "8.11.2",
    "zod": "4.6.6"
  }
}
